# PCB 压合助手本机可选环境变量配置模板（复制为 .env 使用；.env 已在 .gitignore 中忽略）
# 提示：也可以直接在 Web 工作台右上角「外部 API 与脱敏配置」中图形化保存多渠道并点击「测试连接」。
# 配置优先级：命令行参数 > 系统环境变量 > 本文件 (.env) > .private/agent_profile.json 激活渠道

# 默认知识库目录（相对仓库根目录或绝对路径）
# PCB_CATALOG=data/phase3_catalog_v9

# 默认激活的命名渠道（对应 .private/agent_profile.json 中的渠道名）
# PCB_PROFILE=default

# 是否允许通过本机二次脱敏网关调用外部模型（默认 false 纯本地离线）
PCB_ALLOW_CLOUD_EGRESS=false

# 出境证据范围：public_only（仅公开资料） | sanitized_catalog（经二次脱敏零残留的 Catalog 摘录）
PCB_EGRESS_SCOPE=public_only

# 是否启用多步受控 Agent 只读查证循环
PCB_AGENT_LOOP=true

# 接口协议：openai_chat_completions（DeepSeek/NewAPI/百炼/Ollama） | openai_responses（OpenAI Responses）
PCB_LLM_PROVIDER=openai_chat_completions

# 模型网关地址与模型名称（示例：DeepSeek / 内部 NewAPI 网关 / 本机 Ollama）
# PCB_LLM_BASE_URL=https://api.deepseek.com/v1
# PCB_LLM_MODEL=deepseek-chat
# PCB_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=sk-replace-with-your-key

# 若连接本机 http://127.0.0.1:11434/v1 (Ollama / vLLM)，需显式开启：
# PCB_ALLOW_LOCALHOST_HTTP=true
